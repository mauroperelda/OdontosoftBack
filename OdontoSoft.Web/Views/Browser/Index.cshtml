                function getLoadParameters(loadOptions) {
                    var parameters = {};

                    parameters.BrowserCode = browserCode;
                    parameters.Skip = loadOptions.skip;
                    parameters.Take = loadOptions.take;

                    parameters.Filter = getFilterOptions(loadOptions);
                    parameters.Sort = getSortOptions(loadOptions);
                    parameters.Group = getGroupOptions(loadOptions);
                    parameters.Search = getSearchOptions(loadOptions);

                    return parameters;
                }


            function getFilterOptions(loadOptions) {
                var filterOptions = { Items: [] };
                if (loadOptions.filter && loadOptions.filter.length > 0) {
                    if (typeof loadOptions.filter[0] == "string") {
                        filterOptions.Items.push({ Field: loadOptions.filter[0], Operation: loadOptions.filter[1], Value: loadOptions.filter[2] });
                    }
                    else if (Array.isArray(loadOptions.filter[0])) {
                        filterOptions.Items = getFilterOptionItems(loadOptions.filter);
                    }
                }
                return filterOptions;
            }

            function getFilterOptionItems(items) {
                var filterOptionItems = []
                for (itemIndex = 0; itemIndex < items.length; itemIndex++) {
                    var item = items[itemIndex];
                    if (typeof item == "string") {
                        filterOptionItems.push({ Condition: item });
                    }
                    else if (Array.isArray(item) && typeof item[0] == "string") {
                        filterOptionItems.push({ Field: item[0], Operation: item[1], Value: item[2] });
                    }
                    else {
                        filterOptionItems.push({ Items: getFilterOptionItems(item) });
                    }
                }

                return filterOptionItems;
            }

            function getSortOptions(loadOptions) {
                var sortOptions = { Fields: [] };
                if (loadOptions.sort && loadOptions.sort != null && loadOptions.sort.length > 0) {
                    $(loadOptions.sort).each(function(index, item) {
                        sortOptions.Fields.push({ Field: item.selector, Descending: item.desc });
                    });
                }
                return sortOptions;
            }

            function getGroupOptions(loadOptions) {
                var groupOptions = { DataField: loadOptions.dataField, Fields: [] };
                if (loadOptions.group && loadOptions.group != null && loadOptions.group.length > 0) {
                    $(loadOptions.group).each(function(index, item) {
                        groupOptions.Fields.push({ Field: item.selector, IsExpanded: item.isExpanded });
                    });
                }
                return groupOptions;
            }

            function getSearchOptions(loadOptions) {
                return {
                    Value: loadOptions.searchValue ? loadOptions.searchValue : null,
                    Operation: loadOptions.searchOperation ? loadOptions.searchOperation : null,
                    Expression: loadOptions.searchExpr ? loadOptions.searchExpr : null
                };
            }

            var urlDeleteAjax = '@Model.Settings.Delete.GetUrl()';
            function DeleteRecord(id, rowIndex) {
