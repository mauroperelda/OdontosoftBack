            function AjaxActionCall(url, id, confirmTitle, confirmMessage, successTitle, successMessage) {
                Medve.Bootbox.confirm(
                    confirmTitle,
                    confirmMessage,
                    "Aceptar",
                    "Cancelar",
                    function() {
                        $('.global-loader').show();
                        var conn = new Medve.Connector();

                        conn.doRequest({
                            url: url,
                            type: 'GET',
                            dataType: 'json',
                            data: { id: id },
                            success: function(result) {
                                $('.global-loader').hide();
                                Medve.Bootbox.alertSuccess(successTitle, successMessage, "Cerrar");
                            },
                            cancel: function(e) {
                                $('.global-loader').hide();
                                var errorMessage = "Ha ocurrido un error al contactarse con el servidor";
                                if (e.Head && e.Head.Msg) {
                                    errorMessage = e.Head.Msg;
                                }
                                if (typeof e == "string" && e != "") {
                                    errorMessage = e;
                                }
                                Medve.Bootbox.alertDanger("Error", errorMessage, "Cerrar");
                            }
                        });
                    });
            }

            var dataSource = new DevExpress.data.DataSource({
                load: function(loadOptions) {
                    var d = new $.Deferred();
                    var parameters = getLoadParameters(loadOptions);
                    $.getJSON('@Url.Action("GetBrowserDatasource", "Browser")', { parametersString: JSON.stringify(parameters) }).done(function(result) {
                        d.resolve(result.Data.Data.Items, { totalCount: result.Data.Data.TotalCount });
                    });
                    return d.promise();
                },
                remove: function(key) {
                    var d = new $.Deferred();
                    var conn = new Medve.Connector();

                    conn.doRequest({
                        url: urlDeleteAjax,
                        data: { id: key.Id },
                        dataType: 'json',
                        type: 'POST',
                        success: function(result) {
                            //alert(11);
                            d.resolve(true);
                        },
                        error: function(e) {
                            var errorMessage = "Ha ocurrido un error al contactarse con el servidor";
                            if (e.Head && e.Head.Msg) {
                                errorMessage = e.Head.Msg;
                            }
                            if (typeof e == "string" && e != "") {
                                errorMessage = e;
                            }
                            d.reject(errorMessage);
                            Medve.Bootbox.alertDanger("Error", errorMessage, "Cerrar");
                        }
                    });
                    return d.promise();
                }
            });

