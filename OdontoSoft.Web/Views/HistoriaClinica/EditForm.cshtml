@model OdontoSoft.Domain.Models.HistoriaClinica
@using OdontoSoft.Web.Helpers

@{
    ViewBag.Title = "Formulario";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <h4 class="page-title">Formulario de HistoriaClinica</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="row mb-3">
                        <div class="col-md-12">
                            @Html.ValidationSummary(true)
                            @Html.HiddenFor(model => model.Id)
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(x => x.Paciente)
                            @Html.DropDownList("PacienteId", (SelectList)ViewBag.Paciente, String.Empty, new Dictionary<string, object> { { "class", "form-select" } })
                            @Html.ValidationMessageFor(model => model.Paciente)
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(x => x.Alergias)
                            @Html.TextBoxFor(x => x.Alergias, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Alergias)
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(x => x.Medicamentos)
                            @Html.TextBoxFor(x => x.Medicamentos, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Medicamentos)
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(x => x.AntecedentesMedicos)
                            @Html.TextBoxFor(x => x.AntecedentesMedicos, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.AntecedentesMedicos)
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(x => x.Observaciones)
                            @Html.TextBoxFor(x => x.Observaciones, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Observaciones)
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(x => x.FichasTratamiento)
                            @*TIPO NO DEFINIDO - System.Collections.Generic.ICollection`1[OdontoSoft.Domain.Models.FichaTratamiento] -*@ @Html.TextBoxFor(x => x.FichasTratamiento, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.FichasTratamiento)
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(x => x.OdontogramaPiezas)
                            @*TIPO NO DEFINIDO - System.Collections.Generic.ICollection`1[OdontoSoft.Domain.Models.OdontogramaPieza] -*@ @Html.TextBoxFor(x => x.OdontogramaPiezas, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.OdontogramaPiezas)
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            Deshabilitado<br />
                            @Html.CheckBoxFor(x => x.Disabled, new { @class = "form-check-input"})
                            @Html.ValidationMessageFor(model => model.Disabled)
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12 button-list">
                            <input type="submit" class="btn btn-primary" value="Guardar" />
                            <a class="btn text-muted d-none d-sm-inline-block btn-link fw-semibold" href="@Url.Action("Index", "Browser", new { code = Model.GetType().Name })"><i class="mdi mdi-arrow-left"></i>Volver al listado</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

