@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
    <title>ExtraCore - [Olvidé mi contraseña]</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description" />
        <meta content="Coderthemes" name="author" />
        <!-- App favicon -->    
        <link rel="shortcut icon" href="@Url.Content("~/images/logo_sm.png")">

        <!-- App css -->
        <!-- third party css -->
        <link href="@Url.Content("~/css/vendor/jquery-jvectormap-1.2.2.css")" rel="stylesheet" type="text/css" />
        <!-- third party css end -->

        <!-- App css -->
        <link href="@Url.Content("~/css/icons.min.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/css/app.css")" rel="stylesheet" type="text/css" id="app-style" />

        <style>
            .bg-orange
            {
                background-color: black;
            }

            .form-check-input:checked {
                background-color: darkorange;
                border-color: darkorange;
            }
        </style>
    </head>
    
    <body class="authentication-bg">
        <div class="account-pages pt-2 pt-sm-5 pb-4 pb-sm-5">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xxl-4 col-lg-5">
