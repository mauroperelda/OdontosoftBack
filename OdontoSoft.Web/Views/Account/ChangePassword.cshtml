@using OdontoSoft.Web.ViewModels.Account
@model ChangePasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
    <title>ExtraCore - [Cambio de contraseña]</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description" />
        <meta content="Coderthemes" name="author" />
        <!-- App favicon -->
    <link rel="shortcut icon" href="@Url.Content("~/images/logo_sm.png")">

        <!-- App css -->
        <!-- third party css -->
        <link href="@Url.Content("~/css/vendor/jquery-jvectormap-1.2.2.css")" rel="stylesheet" type="text/css" />
        <!-- third party css end -->

        <!-- App css -->
        <link href="@Url.Content("~/css/icons.min.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/css/app.css")" rel="stylesheet" type="text/css" id="app-style" />

        <style>
            .bg-orange
            {
                background-color: black;
            }

            .form-check-input:checked {
                background-color: darkorange;
                border-color: darkorange;
            }
        </style>
    </head>
    
    <body class="authentication-bg">
        <div class="account-pages pt-2 pt-sm-5 pb-4 pb-sm-5">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xxl-4 col-lg-5">
                        <div class="card">

                            <!-- Logo -->
                            <div class="card-header pt-4 pb-4 text-center bg-orange">
                                <a href="index.html">
                                    <span><img src="~/images/logo.png" alt="" height="40"></span>
                                </a>
                            </div>

                            <div class="card-body p-4">
                                
                                <div class="text-center w-75 m-auto">
                                    <h4 class="text-dark-50 text-center pb-0 fw-bold">Cambio de contraseña</h4>
                                    <p class="text-muted mb-4">Por favor defina su nueva contraseña.</p>
                                </div>

                                        @if (!String.IsNullOrEmpty(ViewBag.Errors))
                                    {
                        

                                        <div class="text-center w-100 m-auto">
                                            <div class="alert alert-danger" role="alert">@ViewBag.Errors</div>
                                        </div>
                                    }

                                <form asp-controller="account" asp-action="changepassword" method="post">
                                    @Html.HiddenFor(x=>x.Id)
                                    @Html.HiddenFor(x=>x.Hash)
@*
                                    <div class="mb-3">
                                        <label for="emailaddress" class="form-label">Email</label>
                                        <input class="form-control" type="email" id="emailaddress" required="" placeholder="Ingrese su email" asp-for="Email">
                                    </div>*@

                                    <div class="mb-3">
                                        @*<a href="pages-recoverpw.html" class="text-muted float-end"><small>¿Olvidó su contraseña?</small></a>*@
                                        <label for="NewPassword" class="form-label">Nueva contraseña</label>
                                        <div class="input-group input-group-merge">
                                            <input type="password" id="password" class="form-control" placeholder="Nueva contraseña" asp-for="NewPassword">
                                            <div class="input-group-text" data-password="false">
                                                <span class="password-eye"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        @*<a href="pages-recoverpw.html" class="text-muted float-end"><small>¿Olvidó su contraseña?</small></a>*@
                                        <label for="NewPasswordConfirm" class="form-label">Confirmación</label>
                                        <div class="input-group input-group-merge">
                                            <input type="password" id="password" class="form-control" placeholder="Repita nueva contraseña" asp-for="NewPasswordConfirm">
                                            <div class="input-group-text" data-password="false">
                                                <span class="password-eye"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3 mb-0 text-center">
                                        <button class="btn btn-warning" type="submit"> Cambiar contraseña </button>
                                    </div>

                                </form>
                            </div> <!-- end card-body -->
                        </div>
                        <!-- end card -->

           

         @*               <div class="row mt-3">
                            <div class="col-12 text-center">
                                <p class="text-muted">Don't have an account? <a href="pages-register.html" class="text-muted ms-1"><b>Sign Up</b></a></p>
                            </div> <!-- end col -->
                        </div>*@
                        <!-- end row -->

                    </div> <!-- end col -->
                </div>
                <!-- end row -->
            </div>
            <!-- end container -->
        </div>
        <!-- end page -->

        <footer class="footer footer-alt">
        2022 - <script>document.write(new Date().getFullYear())</script> © Odontosoft - Desarrollo <a href="#" target="_blank">Mauro Perelda</a>
        </footer>
        
        
        <!-- bundle -->
        <script src="@Url.Content("~/js/vendor.min.js")"></script>
        <script src="@Url.Content("~/js/app.min.js")"></script>

    </body>
</html>
