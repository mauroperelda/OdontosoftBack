@model OdontoSoft.Entities.Models.Turno
@using OdontoSoft.Web.Helpers

@{
  ViewBag.Title = "Formulario";
}

<div class="row">
  <div class="col-12">
    <div class="page-title-box">
      @*<div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Hyper</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Forms</a></li>
                    <li class="breadcrumb-item active">Form Elements</li>
                </ol>
            </div>*@
      <h4 class="page-title">Formulario de Turno</h4>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        @using (Html.BeginForm())
        {
          @Html.AntiForgeryToken()
                    
          <div class="row mb-3">
            <div class="col-md-12">
              @Html.ValidationSummary(true)
              @Html.HiddenFor(model => model.Id)
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              @Html.LabelFor(x => x.Paciente)
              @Html.DropDownList("PacienteId", (SelectList)ViewBag.Paciente, String.Empty, new Dictionary<string, object> { { "class", "form-select" } })
              @Html.ValidationMessageFor(model => model.Paciente)
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6">
              @Html.LabelFor(x => x.Profesional)
              @Html.DropDownList("ProfesionalId", (SelectList)ViewBag.Profesional, String.Empty, new Dictionary<string, object> { { "class", "form-select" } })
              @Html.ValidationMessageFor(model => model.Profesional)
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6">
              @Html.LabelFor(x => x.Fecha)
              @Html.TextBoxFor(x => x.Fecha, "{0:dd/MM/yyyy}", new { @class = "form-control datepicker" })
              @Html.ValidationMessageFor(model => model.Fecha)
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6">
              @Html.LabelFor(x => x.HoraInicio)
              @Html.TextBoxFor(x => x.HoraInicio, "{0:dd/MM/yyyy}", new { @class = "form-control datepicker" })
              @Html.ValidationMessageFor(model => model.HoraInicio)
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6">
              @Html.LabelFor(x => x.HoraFin)
              @Html.TextBoxFor(x => x.HoraFin, "{0:dd/MM/yyyy}", new { @class = "form-control datepicker" })
              @Html.ValidationMessageFor(model => model.HoraFin)
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6">
              @Html.LabelFor(x => x.Observacion)
              @Html.TextBoxFor(x => x.Observacion, new { @class = "form-control" })
              @Html.ValidationMessageFor(model => model.Observacion)
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6">
              @Html.LabelFor(x => x.Tratamiento)
              @Html.DropDownList("TratamientoId", (SelectList)ViewBag.Tratamiento, String.Empty, new Dictionary<string, object> { { "class", "form-select" } })
              @Html.ValidationMessageFor(model => model.Tratamiento)
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              Deshabilitado<br />
              @Html.CheckBoxFor(x => x.Disabled, new { @class = "form-check-input" })
              @Html.ValidationMessageFor(model => model.Disabled)
            </div>
          </div>
                                        

          <div class="row mb-3">
            <div class="col-md-12 button-list">
              <input type="submit" class="btn btn-primary" value="Guardar" />
              <a class="btn text-muted d-none d-sm-inline-block btn-link fw-semibold" href="@Url.Action("Index", "Browser", new { code = Model.GetType().Name })"><i class="mdi mdi-arrow-left"></i>Volver al listado</a>
            </div>
          </div>
        }
      </div>
    </div>
  </div>
</div>


