<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OdontoSoft.Contracts\OdontoSoft.Contracts.csproj" />
    <ProjectReference Include="..\OdontoSoft.Data\OdontoSoft.Data.csproj" />
    <ProjectReference Include="..\OdontoSoft.Domain\OdontoSoft.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
