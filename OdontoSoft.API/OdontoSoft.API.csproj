<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.0" />
    <PackageReference Include="FluentValidation" Version="11.10.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Legacy: LocalidadController.BulkInsertLocalidades usa SqlBulkCopy (código SQL Server
         que ya no aplica porque la DB es PostgreSQL). Pendiente de remover en una fase futura;
         mientras tanto el paquete se referencia explícitamente para que el controller compile. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OdontoSoft.Contracts\OdontoSoft.Contracts.csproj" />
    <ProjectReference Include="..\OdontoSoft.Data\OdontoSoft.Data.csproj" />
    <ProjectReference Include="..\OdontoSoft.Entities\OdontoSoft.Entities.csproj" />
    <ProjectReference Include="..\OdontoSoft.Services\OdontoSoft.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MedveCore.Common">
      <HintPath>..\lib\MedveCore.Common.dll</HintPath>
    </Reference>
    <Reference Include="Mauro.RepositoryPattern">
      <HintPath>..\lib\Mauro.RepositoryPattern.dll</HintPath>
    </Reference>
    <Reference Include="Mauro.Entities">
      <HintPath>..\lib\Mauro.Entities.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
