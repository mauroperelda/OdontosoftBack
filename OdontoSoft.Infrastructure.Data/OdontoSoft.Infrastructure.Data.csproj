<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OdontoSoft.Infrastructure.Data</RootNamespace>
    <AssemblyName>OdontoSoft.Infrastructure.Data</AssemblyName>
  </PropertyGroup>

  <!-- AuthenticatedUser implementa ICurrentUser leyendo claims del HttpContext.
       Esto requiere el shared framework de ASP.NET Core (lo expone cualquier host Web).
       Se mantiene aqu� (en lugar de en OdontoSoft.Web o en la API) para que ambos
       consumidores puedan registrar la misma implementaci�n en su DI. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Mauro.Entities">
		  <HintPath>..\lib\Mauro.Entities.dll</HintPath>
		</Reference>
		<Reference Include="MedveCore.Common">
			<HintPath>..\lib\MedveCore.Common.dll</HintPath>
		</Reference>
		<!--<Reference Include="MedveCore.Entities">
			<HintPath>..\lib\MedveCore.Entities.dll</HintPath>
		</Reference>-->
		<Reference Include="Mauro.RepositoryPattern">
			<HintPath>..\lib\Mauro.RepositoryPattern.dll</HintPath>
		</Reference>
	</ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OdontoSoft.Application\OdontoSoft.Application.csproj" />
    <ProjectReference Include="..\OdontoSoft.Contracts\OdontoSoft.Contracts.csproj" />
    <ProjectReference Include="..\OdontoSoft.Domain\OdontoSoft.Domain.csproj" />
  </ItemGroup>

</Project>
