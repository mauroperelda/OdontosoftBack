<# 
public void GenerateBrowserXml(Type type)
{
#>
<?xml version="1.0" encoding="utf-8" ?>
<Browser>
  <Settings>
    <Setting Name="Title" Value="<#=type.Name#>"/>
    <Setting Name="BrowserTitle" Value="Administraci n de <#=type.Name#>"/>    
    <Setting Name="Icon" Value="uil-bookmark-full"/>
    <Setting Name="PermissionCode" Value=""/>  <!-- Use Value: "administrator" para rol administrador, "superuser" para rol superusuario o el codigo de permiso requerido, o deje en blanco si no aplica -->
    <BrowserMainAction Name="CreateNew" Enabled="true" Action="EditForm" Controller="<#=type.Name#>" PermissionCode="" Caption="Agregar <#=type.Name#>"/>
    <BrowserMainAction Name="EditForm" Enabled="true" Action="EditForm" Controller="<#=type.Name#>" PermissionCode=""/>
    <BrowserMainAction Name="Delete" Enabled="true" Action="DeleteAjax" Controller="<#=type.Name#>" PermissionCode=""/>
  </Settings>
  <Columns>
<#+ foreach (var prop in type.GetProperties()) { 
    if (prop.Name != "Id" && prop.Name != "EntityName" && prop.Name != "GetString" && prop.Name != "ObjectState") {#>
    <Column Name="<#=prop.Name#>" Title="<#=prop.Name#>" />
<#+ }
} #>
  </Columns>
  <Actions>
	<!-- Ejemplo: Descarga de reporte en formato excel -->
    <!-- <Action Text="Reporte" IconCssClass="fa fa-file-excel-o" Action="DownloadReport" Controller="SomeController" /> -->
	<!-- Ejemplo AJAX: Reiniciar contrase a en usuario -->
