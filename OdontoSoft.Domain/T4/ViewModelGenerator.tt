<# 
public void GenerateEditForm(Type type)
{
#>
@model <#=type#>
@using OdontoSoft.Web.Helpers

@{
    ViewBag.Title = "Formulario";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            @*<div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Hyper</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Forms</a></li>
                    <li class="breadcrumb-item active">Form Elements</li>
                </ol>
            </div>*@
            <h4 class="page-title">Formulario de <#=type.Name #></h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">  
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    
                    <div class="row mb-3">
                        <div class="col-md-12">
                            @Html.ValidationSummary(true)
                            @Html.HiddenFor(model => model.Id)
                        </div>
                    </div>

<#+ foreach (var props in type.GetProperties()) { #>
<# if (AplicaProp(props) && !EsPropFK(props)) { #>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(x => x.<#=props.Name#>)
                            <#=GetFieldHtml(props)#>
                            @Html.ValidationMessageFor(model => model.<#=props.Name#>)
                        </div>
                    </div>
<#+ } #>
<# } #>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            Deshabilitado<br />
                            @Html.CheckBoxFor(x => x.Disabled, new { @class = "form-check-input"})
                            @Html.ValidationMessageFor(model => model.Disabled)
                        </div>
                    </div>
                                        

                    <div class="row mb-3">
                        <div class="col-md-12 button-list">
                            <input type="submit" class="btn btn-primary" value="Guardar" />
							<a class="btn text-muted d-none d-sm-inline-block btn-link fw-semibold" href="@Url.Action("Index", "Browser", new { code = Model.GetType().Name })"><i class="mdi mdi-arrow-left"></i>Volver al listado</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<#+
}
#>

<# 
public void GenerateGeneratedController(Type type)
{
#>
using OdontoSoft.Data.Authentication;
using OdontoSoft.Data.Repository.UOW;
using OdontoSoft.Entities.Models;
using OdontoSoft.Web.Helpers.Authentication;
using OdontoSoft.Web.Browser;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Caching.Memory;
using Microsoft.AspNetCore.Mvc.ModelBinding;

namespace OdontoSoft.Web.Controllers
{
    public partial class <#=type.Name#>Controller : AppBaseBrowserController
    {

        private int _entityId;

        public ActionResult EditForm(int id = 0)
        {
            if (!AllowAction(id)) return Unauthorized();

            <#=type.Name#> entity;

            if (id != 0)
            {                
                entity = _unitOfWork.<#=type.Name#>Repository.GetById(id);
            }
            else
            {
                entity = new <#=type.Name#>();                
            }
            PrepareEntityBeforeLoadForm(entity);
            base.LoadViewBag(PrepareViewBag(entity));
            return View(entity);
        }

        [HttpPost]
        public ActionResult EditForm(<#=type.Name#> entity, Microsoft.AspNetCore.Http.IFormCollection formCollection)
        {
            if (!AllowAction(entity.Id)) return Unauthorized();

            if (ModelState.IsValid)
            {
                try
                {
                    <#=type.Name#> currentModel = null;

                    if (entity.Id != 0)
                    {
                        currentModel = _unitOfWork.<#=type.Name#>Repository.GetById(entity.Id);
                        TryUpdateModelAsync(currentModel);
                    }
                    else
                    {
                        currentModel = entity;
                    }

                    PrepareEntityFromFormData(currentModel, formCollection);
                    ActionsBeforeSave(currentModel, formCollection);

                    if (entity.Id != 0)
                    {
                        _unitOfWork.<#=type.Name#>Repository.Upsert(currentModel);
                    }
                    else
                    {
                        _unitOfWork.<#=type.Name#>Repository.Add(currentModel);
                    }

                    _unitOfWork.Save();
                    _entityId = currentModel.Id;
                    ModelState.SetModelValue("Id", new ValueProviderResult(currentModel.Id.ToString()));    //If ActionsAfterSave throws exception, we need the new Id to return to the view
                    entity = _unitOfWork.<#=type.Name#>Repository.GetById(_entityId);
                    ActionsAfterSave(currentModel, formCollection);
                    return RedirectToBrowser(formCollection);                        
                }
                //catch (MedveValidationException ex)
                //{
                //    this.AddModelErrors(ModelState, ex);
                //}
                catch (Exception ex)
                {
                    if (ex.InnerException != null)
                        if (ex.InnerException.InnerException != null)
                            ModelState.AddModelError(string.Empty, ex.InnerException.InnerException.Message);
                        else
                            ModelState.AddModelError(string.Empty, ex.InnerException.Message);
                    else
                        ModelState.AddModelError(string.Empty, ex.Message);

                }
            }

            PrepareEntityFromFormData(entity, formCollection);
            base.LoadViewBag(PrepareViewBag(entity));
            return View(entity);
        }

        public JsonResult DeleteAjax(int id)
        {
            try
            {
                //ActionsBeforeDelete(id);
                _unitOfWork.<#=type.Name#>Repository.Delete(id);
                _unitOfWork.Save();

                return JsonOk();
            }
            //catch (MedveValidationException ex)
            //{
            //    return JsonError("Se ha producido un error al eliminar el registro. Verfique que el mismo no tenga relaciones asociadas.");
            //}
            catch (Exception ex)
            {
                return JsonError(ex.Message);
                //return JsonError("Se ha producido un error al eliminar el registro. Verfique que el mismo no tenga relaciones asociadas.");
            }
        }

    }
}
<#+
}
#>

<# 
public void GenerateCustomController(Type type)
{
#>
using OdontoSoft.Data.Repository.UOW;
using OdontoSoft.Entities.Models;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Caching.Memory;
using Microsoft.AspNetCore.Mvc.Rendering;

namespace OdontoSoft.Web.Controllers
{
    public partial class <#=type.Name#>Controller : AppBaseBrowserController
    {

        private Dictionary<string, object> PrepareViewBag(<#=type.Name#> entity)
        {            
            Dictionary<string, object> viewBagData = new Dictionary<string, object>();
            //viewBagData.Add("myKey", "myValue");
            
<#+
foreach (var props in type.GetProperties()) 
{
#>
<#
    if (IsDropDownListInt(props)) 
    {
        string realPropName = FirstCharacterToLower(props.Name.Replace("Id", "").Replace("Parent", ""));
        string listName = realPropName + "List";

        if (Nullable.GetUnderlyingType(props.PropertyType) != null) 
        {
#>
